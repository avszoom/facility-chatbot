APP_ENV=local
DATABASE_PATH=data/buildingops.db
AGENT_RUNTIME=deterministic
# For the AWS managed runtime, use AGENT_RUNTIME=agentcore and its ARN.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_QUALIFIER=DEFAULT
# To use the real local AI path, set AGENT_RUNTIME=openai and add the key only
# to your ignored .env file. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_STORE=false
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4096
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=4096
AWS_REGION=us-east-1
WORKER_POLL_SECONDS=0.25
AGENT_WORKER_COUNT=3
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_SECONDS=1
MESSAGE_LEASE_SECONDS=30
INTAKE_DELAY_SECONDS=0.8
AGENT_ANALYSIS_SECONDS=2.2
ACTION_DELAY_SECONDS=1.6
TECHNICIAN_DELAY_SECONDS=12
VERIFICATION_DELAY_SECONDS=3
VITE_API_BASE=http://127.0.0.1:8000
